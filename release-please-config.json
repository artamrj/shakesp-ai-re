{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "d957fe158e066e1cf52738e87ba468c8af481de2",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "shakesp-ai-re",
