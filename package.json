{
  "name": "shakesp-ai-re",
  "version": "0.4.1",
  "description": "AI for any selected text, anywhere, with one shortcut.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:side-by-side": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "bundle": "tauri build",
    "bundle:macos": "tauri build --bundles app,dmg",
    "bundle:windows": "tauri build --bundles nsis,msi",
    "bundle:linux": "tauri build --bundles appimage,deb,rpm",
    "icons": "tauri icon assets/branding/shakesp-ai-re-icon-master.png",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "~2.12.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.3"
  }
}
