{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shakespAIre",
  "version": "0.1.0",
  "identifier": "com.artamrj.shakesp-ai-re",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "shakespAIre",
        "width": 400,
        "height": 545,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Arta",
    "homepage": "https://github.com/artamrj/shakesp-ai-re",
    "copyright": "Copyright © 2026 Arta",
    "category": "Productivity",
    "shortDescription": "AI writing assistance for selected text.",
    "longDescription": "Select text in any application and use a global shortcut to proofread, copy, or replace it with an AI-improved version.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
